{
  "manifest_version": 3,
  "name": "Dropshipping Site Warning",
  "version": "1.1",
  "description": "Warn users when visiting Shopify or possible dropshipping sites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["banner.css"],
      "run_at": "document_idle"
    }
  ]
}